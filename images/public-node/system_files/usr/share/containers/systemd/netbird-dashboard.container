[Unit]
# ntfy alert with the end of the journal when it fails (common/)
OnFailure=bootc-images-notify-failure@%n.service
Description=NetBird dashboard
Wants=network-online.target
After=network-online.target public-node-netbird-config.service
Requires=public-node-netbird-config.service
# Only once the secrets are in place, i.e. after the cutover: before that, the
# NetBird of the public cluster serves the peers, and two management servers
# for the same peers must never run at once.
ConditionPathExists=/etc/public-node/secrets/netbird/datastore-encryption-key

[Container]
Image=docker.io/netbirdio/dashboard:v2.98.0@sha256:3e8a714e2966f96201b817657cf5b6e4304b947b88341fe99639214fb440ea9c
ContainerName=netbird-dashboard
Network=netbird.network
PublishPort=127.0.0.1:8084:80
Environment=NETBIRD_MGMT_API_ENDPOINT=https://netbird.thomelab.net
Environment=NETBIRD_MGMT_GRPC_API_ENDPOINT=https://netbird.thomelab.net
Environment=AUTH_AUTHORITY=https://sso.thomelab.net/realms/self-hosted-apps
Environment=AUTH_CLIENT_ID=netbird-client
Environment=AUTH_AUDIENCE=netbird-client
Environment="AUTH_SUPPORTED_SCOPES=openid profile email offline_access api"
Environment=USE_AUTH0=false
Environment=NETBIRD_GOOGLE_AUTH_ENABLED=false
NoNewPrivileges=true

[Service]
# A stop sends SIGTERM; apps that exit with 128+15 then counted as failed
# and triggered OnFailure alerts (seen at every reboot). 137 (SIGKILL, OOM)
# still counts as a failure.
SuccessExitStatus=143
Restart=always

[Install]
WantedBy=multi-user.target
