{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  "packageRules": [
    {
      // One PR per base image bump, covering every image built on it
      "groupName": "Fedora bootc base image",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/fedora/fedora-bootc"]
    },
    {
      // No digest pin: Fedora pushes a new fedora-bootc:45 every day
      // (~11:30 UTC) and the previous digest stops being pullable at once
      // (404 / "manifest unknown"), so a pinned build broke daily until a
      // Renovate PR was merged (#71, #102). The tag gets the current
      // Fedora 45; the daily scheduled build picks it up. (CentOS keeps
      // old stream10 digests, so the public node stays pinned.)
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/fedora/fedora-bootc"],
      "pinDigests": false
    },
    {
      // A new Fedora release waits for a tick in the Dependency Dashboard:
      // the next number's tag exists long before the release (fedora-bootc:46
      // was rawhide in November 2026), and Renovate can't tell the two apart.
      // Tick it once Fedora has released it. Digest updates within the
      // current release still come on their own (old digests get deleted).
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/fedora/fedora-bootc"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      // Garage upgrades its metadata in place: once the NAS runs a new
      // version there's no going back (garage-version-guard then refuses the
      // older one after a rollback). Never merged without reading the notes.
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/dxflrs/garage"],
      "automerge": false,
      "prBodyNotes": ["⚠️ **One-way upgrade.** Garage migrates its metadata: after the NAS has run this version, a `bootc rollback` won't bring the old Garage back (`garage-version-guard` skips it with an alert). Read the release notes and make sure the night's `garage` backup succeeded before merging."]
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
  ]
}
