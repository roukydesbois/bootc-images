# Keycloak login in front of the homepage: members of homelab-users only,
# same as on the cluster.
[Unit]
# Fetches Keycloak's OIDC config at startup. After a reboot Keycloak needs
# about a minute: ExecStartPre waits for it, and retries never stop
# (systemd's default gives up after 5 failures in 10 s, which left this
# failed after the first reboot with real data).
Wants=keycloak.service
After=keycloak.service
StartLimitIntervalSec=0
Description=oauth2-proxy for the homepage
# ntfy alert with the end of the journal when it fails (common/)
OnFailure=bootc-images-notify-failure@%n.service
Wants=homepage.service
After=homepage.service
ConditionPathExists=/etc/public-node/secrets/homepage/oauth2-proxy.env

[Container]
Image=quay.io/oauth2-proxy/oauth2-proxy:v7.15.6@sha256:c3415e8660af553f5e18f5d90db050614c02493c0ac6260ac59442f6d9b12048
ContainerName=homepage-oauth2-proxy
Network=homepage.network
PublishPort=127.0.0.1:8095:4180
Exec=--upstream=http://homepage:3000/
Environment=OAUTH2_PROXY_PROVIDER=oidc
Environment=OAUTH2_PROXY_OIDC_ISSUER_URL=https://sso.thomelab.net/realms/self-hosted-apps
Environment=OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
Environment=OAUTH2_PROXY_EMAIL_DOMAINS=*
Environment=OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
Environment=OAUTH2_PROXY_PASS_USER_HEADERS=true
Environment=OAUTH2_PROXY_COOKIE_SECURE=true
Environment=OAUTH2_PROXY_REDIRECT_URL=https://home.thomelab.net/oauth2/callback
Environment=OAUTH2_PROXY_COOKIE_NAME=_oauth2_proxy_homepage
Environment=OAUTH2_PROXY_ALLOWED_GROUPS=homelab-users
# OAUTH2_PROXY_CLIENT_ID, _CLIENT_SECRET, _COOKIE_SECRET
EnvironmentFile=/etc/public-node/secrets/homepage/oauth2-proxy.env
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true

[Service]
# A stop sends SIGTERM; apps that exit with 128+15 then counted as failed
# and triggered OnFailure alerts (seen at every reboot). 137 (SIGKILL, OOM)
# still counts as a failure.
SuccessExitStatus=143
# Wait until Keycloak answers locally (127.0.0.1:8090), so this doesn't start,
# fail and alert while Keycloak is still booting
ExecStartPre=/bin/sh -c 'until curl -fs -o /dev/null http://127.0.0.1:8090/realms/self-hosted-apps/.well-known/openid-configuration; do sleep 5; done'
TimeoutStartSec=600
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
