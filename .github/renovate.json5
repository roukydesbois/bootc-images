{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  // Automerge (patch/minor rules below). Renovate merges itself once all
  // checks on the PR are green, instead of GitHub's auto-merge: the ruleset
  // has no required status checks, so GitHub would merge at once. Only
  // during the week in the daytime, so a broken image lands when someone
  // is around (devices pick up merged images on their next bootc update).
  "timezone": "Europe/Paris",
  "platformAutomerge": false,
  "automergeType": "pr",
  "automergeSchedule": ["* 8-19 * * 1-5"],

  // Versions pinned in shell scripts, marked with a comment line
  //   # renovate: datasource=<datasource> depName=<name>
  // right above NAME_VERSION=<version> (zellij in the servers' build.sh)
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/[^/]+/build_files/[^/]+\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],

  "packageRules": [
    {
      // One PR per base image bump, covering every image built on it
      "groupName": "Fedora bootc base image",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/fedora/fedora-bootc"]
    },
    {
      // No digest pin: Fedora pushes a new fedora-bootc:45 every day
      // (~11:30 UTC) and the previous digest stops being pullable at once
      // (404 / "manifest unknown"), so a pinned build broke daily until a
      // Renovate PR was merged (#71, #102). The tag gets the current
      // Fedora 45; the daily scheduled build picks it up. (CentOS keeps
      // old stream10 digests, so the public node stays pinned.)
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/fedora/fedora-bootc"],
      "pinDigests": false
    },
    {
      // A new Fedora release waits for a tick in the Dependency Dashboard:
      // the next number's tag exists long before the release (fedora-bootc:46
      // was rawhide in November 2026), and Renovate can't tell the two apart.
      // Tick it once Fedora has released it. Digest updates within the
      // current release still come on their own (old digests get deleted).
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/fedora/fedora-bootc"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      // One PR for the Universal Blue bases of surfacego3-os's desktop
      // variants (base-main, silverblue-main, kinoite-main), so all three
      // variants get rebuilt and checked together
      "groupName": "Universal Blue base images",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ublue-os/**"]
    },
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      // Patch and minor updates merge on their own once 3 days old, which
      // gives upstream time to pull a broken release. The PR still opens
      // at once (internalChecksFilter none) with a pending
      // renovate/stability-days check. An update whose registry gives no
      // release date keeps that check pending: it never automerges, but
      // you still see the PR.
      "automerge": true,
      "matchUpdateTypes": ["patch", "minor"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "none"
    },
    {
      // Stateful or access-critical services stay manual whatever the
      // update: they migrate their database on upgrade (Keycloak,
      // Vaultwarden, NetBird management, Postgres), and NetBird is the way
      // into everything (0.x minors are its regular releases, and 0.83
      // broke the reverse proxy). Garage has its own rule below.
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "quay.io/keycloak/keycloak",
        "docker.io/vaultwarden/server",
        "docker.io/library/postgres",
        "docker.io/netbirdio/**"
      ],
      "automerge": false
    },
    {
      // Garage upgrades its metadata in place: once the NAS runs a new
      // version there's no going back (garage-version-guard then refuses the
      // older one after a rollback). Never merged without reading the notes.
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/dxflrs/garage"],
      "automerge": false,
      "prBodyNotes": ["⚠️ **One-way upgrade.** Garage migrates its metadata: after the NAS has run this version, a `bootc rollback` won't bring the old Garage back (`garage-version-guard` skips it with an alert). Read the release notes and make sure the night's `garage` backup succeeded before merging."]
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
  ]
}
