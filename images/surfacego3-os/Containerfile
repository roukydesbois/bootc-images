# Fedora major version is pinned on purpose: `latest` moves to a new Fedora
# release on its own, possibly before the COPRs used in build.sh have builds
# for it. Bump this in a PR when upgrading. The niri stages use the same image
# so wvkbd is compiled against the libraries the final image ships.
#
# One image, three desktops, picked with --build-arg DESKTOP (CI pushes each
# one under its own tag, see README.md):
#   niri  -> :latest  niri + DankMaterialShell on base-main
#   gnome -> :gnome   GNOME on silverblue-main
#   kde   -> :kde     Plasma on kinoite-main
ARG DESKTOP=niri
ARG BASE_IMAGE=ghcr.io/ublue-os/base-main:45@sha256:590defe1077d902f77280cbbf0c393303e4669adfa5394beee667c5d2016bc3c
ARG BASE_IMAGE_GNOME=ghcr.io/ublue-os/silverblue-main:45@sha256:5267b53118a240aedebe3f075c6c8329c8f1c8406fccccbf2e939466cecbef15
ARG BASE_IMAGE_KDE=ghcr.io/ublue-os/kinoite-main:45@sha256:e3bc6849dfdc2fae4e2b72fb6d39cf695cf47ac54d0b83415a8ae97ef25b1d85

# Allow build scripts to be referenced without being copied into the final image
FROM scratch AS ctx
COPY build_files /
COPY system_files /system_files
COPY cosign.pub /cosign.pub

# DMS plugins, fetched at the commits pinned in dms/plugins.lock.json
FROM ${BASE_IMAGE} AS dms-plugins
COPY build_files/dms-plugins.sh dms/plugins.lock.json /tmp/
RUN dnf5 -y install git && /tmp/dms-plugins.sh /tmp/plugins.lock.json /out

# Build wvkbd (not packaged in Fedora)
FROM ${BASE_IMAGE} AS wvkbd
# No release tracking (Dependabot can't follow sourcehut tags): check
# https://git.sr.ht/~proycon/wvkbd/refs now and then.
ARG WVKBD_VERSION=v0.15
RUN dnf5 -y install gcc make git scdoc wayland-devel cairo-devel \
        pango-devel libxkbcommon-devel && \
    git clone --depth 1 --branch "${WVKBD_VERSION}" \
        https://git.sr.ht/~proycon/wvkbd /src && \
    make -C /src && \
    make -C /src PREFIX=/usr DESTDIR=/out install

# Base image per desktop. Only the stages the chosen desktop needs are
# built (podman/buildah skip unused stages), so the GNOME and KDE builds
# don't fetch wvkbd or the DMS plugins.
FROM ${BASE_IMAGE} AS desktop-niri
COPY --from=wvkbd /out/usr/ /usr/
# System plugin directory: DMS lists these next to ~/.config/dms/plugins, but
# they can only be updated through this repo, not from the DMS UI
COPY --from=dms-plugins /out/ /etc/xdg/quickshell/dms-plugins/

FROM ${BASE_IMAGE_GNOME} AS desktop-gnome

FROM ${BASE_IMAGE_KDE} AS desktop-kde

FROM desktop-${DESKTOP}
ARG DESKTOP

### [IM]MUTABLE /opt
## Some bootable images, like Fedora, have /opt symlinked to /var/opt, in order to
## make it mutable/writable for users. However, some packages write files to this directory,
## thus its contents might be wiped out when bootc deploys an image, making it troublesome for
## some packages. Eg, google-chrome, docker-desktop.
##
## Uncomment the following line if one desires to make /opt immutable and be able to be used
## by the package manager.

# RUN rm /opt && mkdir /opt

### MODIFICATIONS
## make modifications desired in your image and install packages by modifying the build.sh script
## the following RUN directive does all the things required to run "build.sh" as recommended.

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build.sh "${DESKTOP}"

### LINTING
## Verify final image and contents are correct.
RUN bootc container lint
