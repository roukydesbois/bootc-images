#!/bin/bash
# Update the NAS to the latest image and restart into it. Automatic updates
# are off (NFS and Garage go down meanwhile), so this is run by hand.
#
# Always a full reboot: no --soft-reboot (common/README.md, "No soft reboot").
set -euo pipefail
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"

echo "Updating: NFS and Garage go down until the NAS is back (full reboot)."
exec bootc upgrade --apply
