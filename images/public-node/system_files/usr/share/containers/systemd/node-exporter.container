# node_exporter: host metrics (CPU, memory, disks, network, systemd), scraped
# by prometheus-agent and pushed to thomelab's Prometheus. Listens on
# 127.0.0.1:9100 only.
[Unit]
Description=node_exporter (host metrics for thomelab's Prometheus)
OnFailure=bootc-images-notify-failure@%n.service

[Container]
Image=quay.io/prometheus/node-exporter:v1.12.1
ContainerName=node-exporter
Network=host
# Reads the host through /host (read-only); SELinux would otherwise deny
# a container reading the host's /proc, /sys and filesystems
SecurityLabelDisable=true
Volume=/:/host:ro,rslave
# --collector.systemd asks systemd over the system bus: without the socket it
# failed on every scrape (node_scrape_collector_success 0, no unit states)
Volume=/run/dbus/system_bus_socket:/var/run/dbus/system_bus_socket:ro
Exec=--path.rootfs=/host --web.listen-address=127.0.0.1:9100 --collector.systemd --collector.processes
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true

[Service]
# A stop sends SIGTERM; apps that exit with 128+15 then counted as failed
# and triggered OnFailure alerts (seen at every reboot). 137 (SIGKILL, OOM)
# still counts as a failure.
SuccessExitStatus=143
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
