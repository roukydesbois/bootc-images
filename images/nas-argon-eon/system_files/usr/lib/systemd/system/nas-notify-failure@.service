# Kept for units still naming it: same as the shared
# bootc-images-notify-failure@.service (common/), which new units should use.
[Unit]
Description=Send a ntfy notification about the failure of %i

[Service]
Type=oneshot
# notify retries for up to ~10 minutes
TimeoutStartSec=15min
ExecStart=/usr/libexec/bootc-images/notify-unit-failure %i
