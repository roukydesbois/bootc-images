# gethomepage on home.thomelab.net, reached only through
# homepage-oauth2-proxy (Keycloak login), so it publishes nothing.
[Unit]
Description=Homepage (home.thomelab.net)
# ntfy alert with the end of the journal when it fails (common/)
OnFailure=bootc-images-notify-failure@%n.service

[Container]
Image=ghcr.io/gethomepage/homepage:v2.8.0@sha256:019d8f063a7299e7c1c51ee4a70b692291809af3244894fbec2c2ac7d1f71b18
ContainerName=homepage
Network=homepage.network
# As on the cluster
User=1000:1000
# The Host header oauth2-proxy passes on, and its upstream name
Environment=HOMEPAGE_ALLOWED_HOSTS=home.thomelab.net,homepage:3000
# Logs to the journal, not to /app/config/logs (read-only here)
Environment=LOG_TARGETS=stdout
# Every config file exists (empty ones included), so homepage creates none
Volume=/usr/share/public-node/homepage:/app/config:ro
DropCapability=ALL
NoNewPrivileges=true

[Service]
# A stop sends SIGTERM; apps that exit with 128+15 then counted as failed
# and triggered OnFailure alerts (seen at every reboot). 137 (SIGKILL, OOM)
# still counts as a failure.
SuccessExitStatus=143
Restart=always

[Install]
WantedBy=multi-user.target
