[Unit]
Description=Argon EON Fan, Button and OLED Service
# No After=multi-user.target (upstream has it): greenboot-healthcheck waits
# for this unit and multi-user.target waits for greenboot, so it made an
# ordering cycle and systemd dropped this unit at boot
[Service]
Type=simple
Restart=always
RemainAfterExit=true
ExecStart=/usr/bin/python3 /usr/share/argon/argononed.py SERVICE
[Install]
WantedBy=multi-user.target
