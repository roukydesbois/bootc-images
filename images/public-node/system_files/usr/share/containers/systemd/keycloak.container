[Unit]
# ntfy alert with the end of the journal when it fails (common/)
OnFailure=bootc-images-notify-failure@%n.service
Description=Keycloak (sso.thomelab.net)
Requires=public-node-keycloak-config.service keycloak-postgres.service
After=public-node-keycloak-config.service keycloak-postgres.service
# Only once the secret is in place, i.e. at cutover: before that, the
# public cluster serves sso.thomelab.net, and this Postgres would start empty.
ConditionPathExists=/etc/public-node/secrets/keycloak/db-password

[Container]
Image=quay.io/keycloak/keycloak:26.8.2@sha256:c68e286cacd87b942ac1939a0a1481461109d6acd3a57dc496969a319a76bbf0
ContainerName=keycloak
Network=keycloak.network
PublishPort=127.0.0.1:8090:8080
Exec=start
Environment=KC_DB=postgres
Environment=KC_DB_URL=jdbc:postgresql://keycloak-postgres:5432/keycloak
Environment=KC_DB_USERNAME=keycloak
# KC_DB_PASSWORD
EnvironmentFile=/run/public-node/keycloak/keycloak.env
# Same as the cluster's Keycloak CR
Environment=KC_HOSTNAME=https://sso.thomelab.net
Environment=KC_HOSTNAME_STRICT=false
Environment=KC_PROXY_HEADERS=xforwarded
Environment=KC_HTTP_ENABLED=true
Environment=KC_HTTP_PORT=8080
Environment=KC_HEALTH_ENABLED=true
# One instance: no cluster cache (the operator set up JGroups for that)
Environment=KC_CACHE=local
# The JVM sizes its heap from the container's memory limit (70 %); without
# one it would size it from the whole host
PodmanArgs=--memory=1536m
NoNewPrivileges=true

[Service]
# A stop sends SIGTERM; apps that exit with 128+15 then counted as failed
# and triggered OnFailure alerts (seen at every reboot). 137 (SIGKILL, OOM)
# still counts as a failure.
SuccessExitStatus=143
Restart=always
# First start builds Keycloak's optimized config, which takes a while
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
