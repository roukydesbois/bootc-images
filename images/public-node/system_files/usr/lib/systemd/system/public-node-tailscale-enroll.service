# First boot: join Tailscale (the emergency path) with the auth key placed on
# the disk at install time (README, "Installation"), then delete it.
[Unit]
# ntfy alert with the end of the journal when it fails (common/)
OnFailure=bootc-images-notify-failure@%n.service
Description=Join Tailscale with the auth key placed at install
ConditionPathExists=/etc/tailscale/authkey
Requires=tailscaled.service
After=tailscaled.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/sbin/restorecon -R /etc/tailscale
# --accept-dns=false: Tailscale is break-glass only and must not take over
# the host's DNS. With it, everything resolved through 100.100.100.100, which
# doesn't know NetBird's cluster.local (the Prometheus agent couldn't reach
# thomelab).
ExecStart=/usr/bin/tailscale up --netfilter-mode=off --ssh=false --accept-dns=false --auth-key=file:/etc/tailscale/authkey
ExecStartPost=/usr/bin/rm -f /etc/tailscale/authkey
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
