[Unit]
Description=NetBird mesh network client
ConditionFileIsExecutable=/usr/bin/netbird
After=network.target syslog.target
# This box hosts the NetBird management its own client logs into. After a
# reboot management first waits for Keycloak (about a minute); a client
# started earlier failed and stayed off the mesh until restarted by hand
# (after the cutover). Ordered after it, and ExecStartPre below waits.
After=netbird-management.service

[Service]
StartLimitInterval=5
StartLimitBurst=10

# Wait until the local management answers (any HTTP status, e.g. 401 on the
# API), only when this box runs it (datastore key present), and at most 10
# minutes: then start anyway, Tailscale stays the way in.
ExecStartPre=/bin/sh -c '[ -f /etc/public-node/secrets/netbird/datastore-encryption-key ] || exit 0; for i in $$(seq 1 120); do curl -s -o /dev/null --max-time 5 http://127.0.0.1:8081/api/users && exit 0; sleep 5; done; exit 0'
TimeoutStartSec=15min
ExecStart=/usr/bin/netbird "service" "run" "--log-level" "info" "--daemon-addr" "unix:///var/run/netbird.sock" "--log-file" "/var/log/netbird/client.log"

Restart=always
RestartSec=120
EnvironmentFile=-/etc/sysconfig/netbird
Environment=SYSTEMD_UNIT=netbird

[Install]
WantedBy=multi-user.target
