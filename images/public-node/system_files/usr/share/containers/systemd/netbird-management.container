[Unit]
# Fetches Keycloak's OIDC config at startup. After a reboot Keycloak needs
# about a minute: ExecStartPre waits for it, and retries never stop
# (systemd's default gives up after 5 failures in 10 s, which left this
# failed after the first reboot with real data).
Wants=keycloak.service
After=keycloak.service
StartLimitIntervalSec=0
# ntfy alert with the end of the journal when it fails (common/)
OnFailure=bootc-images-notify-failure@%n.service
Description=NetBird management
Wants=network-online.target
After=network-online.target public-node-netbird-config.service
Requires=public-node-netbird-config.service
# Only once the secrets are in place, i.e. after the cutover: before that, the
# NetBird of the public cluster serves the peers, and two management servers
# for the same peers must never run at once.
ConditionPathExists=/etc/public-node/secrets/netbird/datastore-encryption-key

[Container]
Image=docker.io/netbirdio/management:0.83.1
ContainerName=netbird-management
Network=netbird.network
PublishPort=127.0.0.1:8081:80
# Rendered with the secrets by public-node-netbird-config.service
Volume=/run/public-node/netbird/management.json:/etc/netbird/management.json:ro,Z
# SQLite store, encrypted with the datastore key: they only work together
Volume=/var/lib/netbird/management:/var/lib/netbird:Z
Exec=--port=80 --log-file=console --log-level=info --disable-anonymous-metrics=false --single-account-mode-domain=netbird.thomelab.net --dns-domain=internal.thomelab
NoNewPrivileges=true

[Service]
# Wait until Keycloak answers locally (127.0.0.1:8090), so this doesn't start,
# fail and alert while Keycloak is still booting
ExecStartPre=/bin/sh -c 'until curl -fs -o /dev/null http://127.0.0.1:8090/realms/self-hosted-apps/.well-known/openid-configuration; do sleep 5; done'
TimeoutStartSec=600
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
