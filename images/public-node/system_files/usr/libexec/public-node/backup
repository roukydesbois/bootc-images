#!/bin/bash
# Backup of public-node, to restic (Garage) and borg (BorgBase), each
# independent of the other. `backup` runs hourly, `backup prune` daily.
#   1. dumps into the staging dir: Keycloak's database (pg_dump) and
#      consistent copies of the SQLite databases (sqlite3 .backup) of
#      NetBird, Vaultwarden and ntfy
#   2. backs up the staging dir, the secrets (the NetBird store is useless
#      without its encryption key), Vaultwarden's other files (attachments,
#      keys) and Traefik's certificates
# A destination is used when its file is in the secrets dir (README,
# "Backups"). Paths can be overridden for tests: SECRETS, STATE.
set -euo pipefail
mode=${1:-backup}
secrets=${SECRETS:-/etc/public-node/secrets/backup}
state=${STATE:-/var/lib/public-node/backup}
staging="$state/staging"
paths=("$staging" /etc/public-node/secrets /var/lib/traefik /var/lib/vaultwarden)
# Live SQLite files: their consistent copies are in the staging dir. The
# backup's own secrets stay out: they're needed to read it.
excludes=("$secrets" "/var/lib/vaultwarden/db.sqlite3*")
# Retention, the same on both sides
keep=(--keep-hourly 48 --keep-daily 14 --keep-weekly 8 --keep-monthly 12)

# Backup and prune never run at the same time (repository locks)
exec 9>"$state/lock"
flock 9

dumps() {
    rm -rf "$staging"
    mkdir -m 0700 -p "$staging"
    if systemctl is-active --quiet keycloak-postgres.service; then
        podman exec keycloak-postgres pg_dump -U keycloak -Fc keycloak >"$staging/keycloak.pgdump"
    fi
    sqlite_copy /var/lib/netbird/management/store.db netbird-store.db
    sqlite_copy /var/lib/vaultwarden/db.sqlite3 vaultwarden.sqlite3
    sqlite_copy /var/lib/ntfy/user.db ntfy-user.db
}

# Consistent copy of a live SQLite database, if it exists
sqlite_copy() {
    if [ -f "$1" ]; then
        sqlite3 "$1" ".backup '$staging/$2'"
    fi
}

restic_run() (
    set -a
    # RESTIC_REPOSITORY, AWS_*, RESTIC_PASSWORD_FILE
    . "$secrets/restic.env"
    set +a
    if [ "$mode" = prune ]; then
        restic forget "${keep[@]}" --prune
    else
        restic backup --tag hourly "${excludes[@]/#/--exclude=}" "${paths[@]}"
    fi
)

borg_run() (
    set -a
    # BORG_REPO
    . "$secrets/borg.env"
    set +a
    export BORG_PASSCOMMAND="cat $secrets/borg-passphrase"
    export BORG_RSH="ssh -i $secrets/borg-ssh-key -o UserKnownHostsFile=$state/known_hosts -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=60"
    if [ "$mode" = prune ]; then
        borg prune "${keep[@]}"
        borg compact
    else
        borg create --compression zstd "${excludes[@]/#/--exclude=}" "::{now:%Y-%m-%dT%H:%M}" "${paths[@]}"
    fi
)

[ "$mode" = prune ] || dumps

failed=0
if [ -s "$secrets/restic.env" ]; then
    restic_run || { echo "restic $mode failed" >&2; failed=1; }
fi
if [ -s "$secrets/borg.env" ]; then
    borg_run || { echo "borg $mode failed" >&2; failed=1; }
fi

# Heartbeat to the private gatus (backups_public-node): no successful push
# within 2 hours alerts, which also covers a backup that never runs
gatus_env=${GATUS_ENV:-/etc/public-node/secrets/gatus/gatus.env}
if [ "$mode" = backup ] && [ -r "$gatus_env" ]; then
    token=$(sed -n 's/^BACKUP_HEARTBEAT_TOKEN=//p' "$gatus_env")
    success=$([ "$failed" = 0 ] && echo true || echo false)
    curl -fsS --max-time 10 -X POST -H "Authorization: Bearer $token" \
        "http://127.0.0.1:8094/api/v1/endpoints/backups_public-node/external?success=$success" \
        || echo "heartbeat to gatus failed" >&2
fi
exit "$failed"
